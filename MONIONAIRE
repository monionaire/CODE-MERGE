    def load_raw_history(self) -> bool:
        """Load raw history data."""
        try:
            history_file = os.path.join("LOGGINGS", "raw_history.json")
            
            if not os.path.exists(history_file):
                logger.warning("No raw history file found!")
                print("\n[WARNING] No raw history file found!")
                return False
            
            logger.info(f"Loading raw history from: {history_file}")
            print(f"\nLoading raw history from: {history_file}")
            
            with open(history_file, 'r', encoding='utf-8') as f:
                self.raw_history = json.load(f)
            
            logger.info(f"Loaded raw history with {len(self.raw_history)} prop IDs")
