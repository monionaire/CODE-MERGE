        except:
            return game_time
    
    def format_line_history(self, entries: List[Dict]) -> str:
        """Format line history with arrows showing direction between consecutive values."""
        if not entries:
            return ""
        
        # Sort entries by timestamp
        sorted_entries = sorted(entries, key=lambda x: x.get("timestamp", ""))
        
        # Extract line values
        values = []
        for entry in sorted_entries:
            line = entry.get("line")
            if line is not None:
                try:
                    values.append(float(line))
                except:
                    pass
        
        if not values:
            return ""
        
        # Build history string with arrows
        parts = []
        for i, value in enumerate(values):
            if i == 0:
                # First value: always black, no arrow
                parts.append(f"{value:.1f}")
            else:
                # Compare with previous value
                prev_value = values[i-1]
                if value > prev_value:
                    parts.append(f"↑{value:.1f}")  # Increased
                elif value < prev_value:
                    parts.append(f"↓{value:.1f}")  # Decreased
                else:
                    parts.append(f"{value:.1f}")  # Same
        
        return "→".join(parts)
    
