    def get_all_sportsbooks(self) -> Set[str]:
        """Get all unique sportsbooks from raw history (from Code 1)."""
        sportsbooks = set()
        
        for prop_id, entries in self.raw_history.items():
            for entry in entries:
                book = entry.get("book", "").strip()
                if book:
                    sportsbooks.add(book)
        
        return sorted(sportsbooks)
    
    def assign_sportsbook_colors(self, sportsbooks: List[str]) -> Dict[str, str]:
        """Assign a unique color to each sportsbook (from Code 1)."""
        color_names = list(self.sportsbook_colors.keys())
        color_map = {}
        
        for i, sportsbook in enumerate(sportsbooks):
            color_idx = i % len(color_names)
            color_map[sportsbook] = color_names[color_idx]
        
        return color_map
    
    def calculate_percentage_change(self, first_value: float, current_value: float) -> float:
        """Calculate percentage change from first to current (from Code 2)."""
        try:
            if first_value == 0:
                return 0.0 if current_value == 0 else 100.0
            return ((current_value - first_value) / abs(first_value)) * 100
        except:
            return 0.0
    
    def format_percentage(self, percentage: float) -> str:
        """Format percentage with sign (from Code 2)."""
        if percentage > 0:
            return f"+{percentage:.1f}%"
        elif percentage < 0:
            return f"{percentage:.1f}%"
        else:
            return f"{percentage:.1f}%"
    
    def format_game_time(self, game_time: str) -> str:
        """Format game time to readable format (from Code 2)."""
        try:
            dt = datetime.fromisoformat(game_time.replace('Z', '+00:00'))
            return dt.strftime("%a %-m/%-d %-I:%M%p").lower()
        except:
            return game_time
    
    def build_headers(self, sportsbooks: List[str]) -> List[str]:
        """Build headers with sportsbook columns (from Code 1 - KEY METHOD)."""
        headers = self.base_headers.copy()
        self.sportsbook_columns = {}
        
        # Assign colors to sportsbooks
        self.sportsbook_color_map = self.assign_sportsbook_colors(sportsbooks)
        
        # Create 4 columns for each sportsbook (horizontal layout)
        for idx, sportsbook in enumerate(sportsbooks):
            start_idx = len(headers)
            new_cols = [
                f"CURRENT LINE ({sportsbook})",
                f"PRICE ({sportsbook})",
                f"% CHANGE ({sportsbook})",
                f"LINE HISTORY ({sportsbook})"
            ]
            headers.extend(new_cols)
            
            # Track column indices for this sportsbook
            self.sportsbook_columns[sportsbook] = {
                'current_line': start_idx,
                'price': start_idx + 1,
                'percentage': start_idx + 2,
                'history': start_idx + 3
            }
        
        logger.info(f"Created headers with {len(sportsbooks)} sportsbooks")
        print(f"[HEADERS] Created {len(sportsbooks)} sportsbook blocks")
        
        return headers
    
    def get_column_letter(self, col_idx: int) -> str:
        """Convert column index to letter (1-based) (from Code 1)."""
        result = ""
        while col_idx > 0:
            col_idx, remainder = divmod(col_idx - 1, 26)
            result = chr(65 + remainder) + result
        return result
    
    def ensure_sheet_exists(self) -> bool:
        """Ensure sheet exists with proper headers (from Code 1)."""
        try:
            try:
                self.sheet = self.spreadsheet.worksheet("LINE MOVEMENT")
                print("[SUCCESS] Found existing LINE MOVEMENT sheet")
                
                # Get sportsbooks and build new headers
                sportsbooks = self.get_all_sportsbooks()
                new_headers = self.build_headers(sportsbooks)
                existing_headers = self.sheet.row_values(1)
                
                # Update headers if they don't match
                if not existing_headers or existing_headers != new_headers:
                    print("Updating headers...")
                    self.sheet.clear()
                    self.sheet.update([new_headers], "A1")
                    self.all_headers = new_headers
                    print("[SUCCESS] Updated headers")
                else:
                    self.all_headers = existing_headers
                    self.rebuild_sportsbook_columns()
                    
                return True
                
            except gspread.exceptions.WorksheetNotFound:
                print("Creating new LINE MOVEMENT sheet...")
                sportsbooks = self.get_all_sportsbooks()
                self.all_headers = self.build_headers(sportsbooks)
                self.sheet = self.spreadsheet.add_worksheet(
                    title="LINE MOVEMENT", 
                    rows=5000, 
                    cols=max(20, len(self.all_headers))
                )
                self.sheet.update([self.all_headers], "A1")
                print(f"[SUCCESS] Created new sheet with {len(sportsbooks)} sportsbooks")
                return True
                
        except Exception as e:
            logger.error(f"Failed to ensure sheet exists: {str(e)}")
            print(f"\n[FAILED] Failed to ensure sheet exists: {str(e)}")
            return False
    
    def rebuild_sportsbook_columns(self):
        """Rebuild sportsbook columns from existing headers (from Code 1)."""
        self.sportsbook_columns = {}
        
        for idx, header in enumerate(self.all_headers):
            if "(" in header and ")" in header:
                parts = header.split("(")
                if len(parts) == 2:
                    col_type = parts[0].strip()
                    sportsbook = parts[1].replace(")", "").strip()
                    
                    if sportsbook not in self.sportsbook_columns:
                        self.sportsbook_columns[sportsbook] = {}
                    
                    if "CURRENT LINE" in col_type:
                        self.sportsbook_columns[sportsbook]['current_line'] = idx
                    elif "PRICE" in col_type and "%" not in col_type:
                        self.sportsbook_columns[sportsbook]['price'] = idx
                    elif "% CHANGE" in col_type:
                        self.sportsbook_columns[sportsbook]['percentage'] = idx
                    elif "LINE HISTORY" in col_type:
                        self.sportsbook_columns[sportsbook]['history'] = idx
    
    def process_prop_data(self) -> List[List[str]]:
        """Process all prop data and create rows (from Code 1 - KEY METHOD)."""
        rows = []
        prop_groups = defaultdict(lambda: defaultdict(list))
        
        # Group props by (player, market, event, sport)
        for prop_id, entries in self.raw_history.items():
            if not entries:
                continue
            
            first_entry = entries[0]
            player = first_entry.get("player", "").strip()
            market = first_entry.get("market", "").strip()
            event = first_entry.get("event", "").strip()
            sport = first_entry.get("sport", "").strip()
            game_time = first_entry.get("game_time", "")
            
            key = (player, market, event, sport)
            
            # Group all entries by sportsbook for this prop
            for entry in entries:
                book = entry.get("book", "").strip()
                if book:
                    prop_groups[key][book].append(entry)
        
        print(f"\nProcessing {len(prop_groups)} unique props...")
        
        # Create ONE row per prop with ALL sportsbooks
        for idx, ((player, market, event, sport), book_data) in enumerate(prop_groups.items()):
            first_book = next(iter(book_data.values()))
            prop_id = first_book[0].get("prop_id", "") if first_book else ""
            
            # Get game_time from first entry
            game_time = first_book[0].get("game_time", "") if first_book else ""
            
            row = self.create_row_for_prop(
                prop_id=prop_id,
                player=player,
                market=market,
                sport=sport,
                event=event,
                game_time=game_time,
                book_data=book_data
            )
            
            if row:
                rows.append(row)
            
            if (idx + 1) % 50 == 0:
                print(f"[PROGRESS] Processed {idx + 1}/{len(prop_groups)} props")
        
        logger.info(f"Created {len(rows)} rows")
        print(f"\n[SUCCESS] Created {len(rows)} rows with multiple sportsbooks")
        
        return rows
    
    def create_row_for_prop(self, prop_id: str, player: str, market: str, sport: str, 
                           event: str, game_time: str, book_data: Dict[str, List[Dict]]) -> List[str]:
        """Create a row for one prop with all sportsbooks (from Code 1 - KEY METHOD)."""
        row = [''] * len(self.all_headers)
        
        # Fill base columns
        row[0] = prop_id
        row[1] = player
        row[2] = market
        row[3] = sport
        row[4] = event
        
        if game_time:
            row[5] = self.format_game_time(game_time)
        
        # Fill data for each sportsbook in its respective columns
        for sportsbook, entries in book_data.items():
            if sportsbook not in self.sportsbook_columns:
                continue
            
            cols = self.sportsbook_columns[sportsbook]
            
            if not entries:
                continue
            
            # Sort entries by timestamp
            sorted_entries = sorted(entries, key=lambda x: x.get("timestamp", ""))
            latest = sorted_entries[-1]
            current_line = latest.get("line")
            current_price = latest.get("price")
            
            # Get first entry for percentage calculation
            first = sorted_entries[0]
            first_line = first.get("line")
            percentage = self.calculate_percentage_change(first_line, current_line)
            
            # Build history string
            history_parts = []
            for entry in sorted_entries:
                line = entry.get("line")
                if line is not None:
                    history_parts.append(f"{float(line):.1f}")
            
            history = "→".join(history_parts)
            
            # Fill the 4 columns for this sportsbook
            if cols['current_line'] < len(row):
                row[cols['current_line']] = str(current_line) if current_line is not None else ""
            
            if cols['price'] < len(row):
                row[cols['price']] = str(current_price) if current_price is not None else ""
            
            if cols['percentage'] < len(row):
                row[cols['percentage']] = self.format_percentage(percentage)
            
            if cols['history'] < len(row):
                row[cols['history']] = history
        
        return row
    
    def apply_sportsbook_background_colors(self):
        """Apply background colors to each sportsbook's column block (from Code 1)."""
        print("\n[BACKGROUND COLORS] Applying sportsbook background colors...")
        
        color_requests = []
        
        for sportsbook, cols in self.sportsbook_columns.items():
            if sportsbook in self.sportsbook_color_map:
                color_name = self.sportsbook_color_map[sportsbook]
                color = self.sportsbook_colors[color_name]
                
                # Get column letters for this sportsbook's 4-column block
                start_col = self.get_column_letter(cols['current_line'] + 1)
                end_col = self.get_column_letter(cols['history'] + 1)
                
                # Apply to header row (row 1)
                header_range = f"{start_col}1:{end_col}1"
                color_requests.append({
                    "range": header_range,
                    "format": {
                        "backgroundColor": color,
                        "textFormat": {"bold": True}
                    }
                })
                
                # Apply to all data rows (assuming max 5000 rows)
                data_range = f"{start_col}2:{end_col}5000"
                color_requests.append({
                    "range": data_range,
                    "format": {
                        "backgroundColor": color
                    }
                })
                
                print(f"  {sportsbook}: {color_name} ({start_col}-{end_col})")
        
        # Apply all background colors in batches
        batch_size = 10
        for i in range(0, len(color_requests), batch_size):
            batch = color_requests[i:i + batch_size]
            try:
                self.sheet.batch_format(batch)
                time.sleep(2)  # Delay to avoid rate limits
            except Exception as e:
                print(f"    Warning: Could not apply some background colors: {str(e)}")
    
    def apply_colors_with_rate_limit_protection(self, rows: List[List[str]]):
        """Apply colors with RATE LIMIT PROTECTION using batch updates (from Code 1)."""
        print("\n" + "="*80)
        print("APPLYING COLORS WITH RATE LIMIT PROTECTION")
        print("="*80)
        
        if not rows:
            return
        
        total_rows = len(rows)
        print(f"Processing {total_rows} rows for color coding...")
        
        # Apply sportsbook background colors first
        self.apply_sportsbook_background_colors()
        
        # Build lookup for easier access
        entries_by_prop_book = defaultdict(lambda: defaultdict(list))
        for prop_id, entries in self.raw_history.items():
            for entry in entries:
                book = entry.get("book", "").strip()
                if book:
                    entries_by_prop_book[prop_id][book].append(entry)
        
        print("\n[STEP 1] Preparing all color data...")
        
        # Collect ALL color data first
        all_price_colors = []
        all_percentage_colors = []
        all_history_colors = []
        all_line_colors = []
        
        for row_idx, row in enumerate(rows, start=2):
            prop_id = row[0]
            
            for sportsbook, cols in self.sportsbook_columns.items():
                # ========== PRICE COLOR ==========
                price_col = self.get_column_letter(cols['price'] + 1)
                price_cell = f"{price_col}{row_idx}"
                
                price_value = None
                if cols['price'] < len(row):
                    price_str = row[cols['price']]
                    if price_str:
                        try:
                            clean_str = price_str.replace('+', '')
                            price_value = float(clean_str)
                        except:
                            price_value = None
                
                # Determine price color
                price_color = self.black_color  # Default
                if price_value is not None:
                    if price_value < 0:
                        price_color = self.red_color  # Negative odds = RED
                    elif price_value > 0:
                        price_color = self.green_color  # Positive odds = GREEN
                    elif price_value == 0 or price_value == 100:
                        price_color = self.green_color  # 100 or 0 = GREEN
                
                all_price_colors.append({
                    "range": price_cell,
                    "format": {"textFormat": {"bold": True, "foregroundColor": price_color}}
                })
                
                # ========== % CHANGE COLOR ==========
                percentage_col = self.get_column_letter(cols['percentage'] + 1)
                percentage_cell = f"{percentage_col}{row_idx}"
                
                percentage_value = 0.0
                if cols['percentage'] < len(row):
                    percentage_str = row[cols['percentage']]
                    if percentage_str and percentage_str.endswith('%'):
                        try:
                            clean_str = percentage_str.strip('%').replace('+', '')
                            percentage_value = float(clean_str)
                        except:
                            percentage_value = 0.0
                
                # Determine percentage color
                percentage_color = self.black_color
                if percentage_value > 0:
                    percentage_color = self.green_color
                elif percentage_value < 0:
                    percentage_color = self.red_color
                
                all_percentage_colors.append({
                    "range": percentage_cell,
                    "format": {"textFormat": {"bold": True, "foregroundColor": percentage_color}}
                })
                
                # ========== HISTORY COLOR ==========
                history_col = self.get_column_letter(cols['history'] + 1)
                history_cell = f"{history_col}{row_idx}"
                
                history_color = self.black_color
                if (prop_id in entries_by_prop_book and 
                    sportsbook in entries_by_prop_book[prop_id]):
                    
                    entries = entries_by_prop_book[prop_id][sportsbook]
                    if len(entries) >= 2:
                        sorted_entries = sorted(entries, key=lambda x: x.get("timestamp", ""))
                        last_entry = sorted_entries[-1]
                        prev_entry = sorted_entries[-2]
                        
                        last_line = last_entry.get("line")
                        prev_line = prev_entry.get("line")
                        
                        if last_line is not None and prev_line is not None:
                            try:
                                last_line_float = float(last_line)
                                prev_line_float = float(prev_line)
                                
                                if last_line_float > prev_line_float:
                                    history_color = self.green_color
                                elif last_line_float < prev_line_float:
                                    history_color = self.red_color
                            except:
                                pass
                
                all_history_colors.append({
                    "range": history_cell,
                    "format": {"textFormat": {"bold": True, "foregroundColor": history_color}}
                })
                
                # ========== CURRENT LINE COLOR ==========
                line_col = self.get_column_letter(cols['current_line'] + 1)
                line_cell = f"{line_col}{row_idx}"
                
                all_line_colors.append({
                    "range": line_cell,
                    "format": {"textFormat": {"bold": True, "foregroundColor": self.black_color}}
                })
            
            if row_idx % 100 == 0:
                print(f"  Prepared colors for {row_idx-1}/{total_rows} rows")
        
        print(f"\n[STEP 2] Applying colors in batches with rate limiting...")
        print(f"  Total cells to color: {len(all_price_colors) * 4}")
        
        # Apply colors in VERY SMALL batches with longer delays
        batch_size = 10
        
        # Combine all color requests
        all_color_requests = (all_price_colors + all_percentage_colors + 
                            all_history_colors + all_line_colors)
        
        total_batches = (len(all_color_requests) + batch_size - 1) // batch_size
        
        print(f"\n[STEP 3] Applying {len(all_color_requests)} color formats")
        print(f"  Batch size: {batch_size} requests")
        print(f"  Total batches: {total_batches}")
        print(f"  Estimated time: {total_batches * 3} seconds")
        print("\nStarting batch updates (will be slow but WILL work)...")
        
        successful_batches = 0
        failed_batches = 0
        
        for i in range(0, len(all_color_requests), batch_size):
            batch = all_color_requests[i:i + batch_size]
            batch_num = (i // batch_size) + 1
            
            print(f"\n  Batch {batch_num}/{total_batches} ({len(batch)} cells)...")
            
            try:
                # Use batch_format for efficiency
                self.sheet.batch_format(batch)
                successful_batches += 1
                print("    OK: Successfully applied")
            except Exception as e:
                failed_batches += 1
                print(f"    FAIL: {str(e)[:100]}...")
            
            # CRITICAL: Wait 3 seconds between batches to stay under 60/minute limit
            if batch_num < total_batches:
                print(f"    Waiting 3 seconds to avoid rate limit...")
                time.sleep(3)  # 3 seconds = 20 batches per minute = well under 60 limit
        
        print("\n" + "="*80)
        print("COLOR CODING COMPLETE!")
        print("="*80)
        print(f"OK: Successful batches: {successful_batches}/{total_batches}")
        print(f"OK: Failed batches: {failed_batches}")
        print("OK: Each sportsbook has its own background color")
        print("OK: PRICE: Negative odds = RED, Positive odds = GREEN")
        print("OK: % CHANGE: Positive = GREEN, Negative = RED, Zero = BLACK")
        print("OK: LINE HISTORY: Based on last movement")
        print("OK: CURRENT LINE: BLACK")
        print("OK: ALL TEXT: BOLD")
        print("="*80)
        print("\nWARNING: Colors may take a minute to fully appear in Google Sheets.")
        print("   Refresh your sheet to see the updates.")
    
    def update_sheet(self):
        """Update the sheet with RATE-LIMIT PROTECTED color coding (from Code 1)."""
        try:
            rows = self.process_prop_data()
            
            if not rows:
                print("No data to update!")
                return 0, 0
            
            print(f"\nUpdating sheet with {len(rows)} rows...")

            # Ensure sheet has enough rows/cols for the update
            required_rows = len(rows) + 1
            required_cols = len(self.all_headers)
            if self.sheet.row_count < required_rows:
                self.sheet.add_rows(required_rows - self.sheet.row_count)
            if self.sheet.col_count < required_cols:
                self.sheet.add_cols(required_cols - self.sheet.col_count)
            
            # Clear existing data FIRST
            print("Clearing existing data...")
            if len(self.sheet.get_all_values()) > 1:
                end_col = self.get_column_letter(len(self.all_headers))
                data_range = f"A2:{end_col}{len(rows) + 100}"
                self.sheet.batch_clear([data_range])
                print("  Data cleared")
            
            # Add new rows
            print("Adding new rows...")
            if rows:
                end_col = self.get_column_letter(len(self.all_headers))
                update_range = f"A2:{end_col}{len(rows) + 1}"
                
                # Split into smaller updates to avoid rate limits
                chunk_size = 100
                for i in range(0, len(rows), chunk_size):
                    chunk = rows[i:i + chunk_size]
                    chunk_start = i + 2
                    chunk_end = i + len(chunk) + 1
                    chunk_range = f"A{chunk_start}:{end_col}{chunk_end}"
                    
                    print(f"  Adding rows {i+1} to {i+len(chunk)}...")
                    self.sheet.update(chunk, chunk_range)
                    
                    # Small delay between chunks
                    if i + chunk_size < len(rows):
                        time.sleep(1)
                
                print(f"  All {len(rows)} rows added")
                
                # Apply colors with rate limit protection
                self.apply_colors_with_rate_limit_protection(rows)
                
                print(f"\n[SUCCESS] Updated sheet with {len(rows)} rows")
            
            return len(rows), 0
            
        except Exception as e:
            logger.error(f"Error updating sheet: {str(e)}")
            print(f"\n[FAILED] Error updating sheet: {str(e)}")
            return 0, 0
    
