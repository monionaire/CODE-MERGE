        # Extract line values
        values = []
        for entry in sorted_entries:
            line = entry.get("line")
            if line is not None:
                try:
                    values.append(float(line))
                except:
                    pass
        
        if not values:
            return ""
        
        # Build history with arrows
        parts = []
        for i, value in enumerate(values):
            if i == 0:
                parts.append(f"{value:.1f}")
            else:
                prev_value = values[i-1]
                if value > prev_value:
                    parts.append(f"↑{value:.1f}")
                elif value < prev_value:
                    parts.append(f"↓{value:.1f}")
                else:
