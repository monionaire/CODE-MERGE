            self.client = gspread.authorize(creds)
            self.spreadsheet = self.client.open_by_key(SHEET_ID)
            
            logger.info(f"[SUCCESS] Connected to Google Sheet: {SHEET_ID}")
            print(f"[SUCCESS] Connected to Google Sheet: {SHEET_ID}")
